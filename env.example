# OurTrip — local environment template.
#
# Copy to .env.local and fill in. `.env*` is gitignored, which is why this
# template is named `env.example` (no leading dot) — it is the one env file in
# the repo, and it must never hold a real value.
#
#   cp env.example .env.local
#
# Everything here is NEXT_PUBLIC_*, i.e. it ships to the browser by definition.
# Server-side keys (ANTHROPIC_API_KEY, RAPIDAPI_KEY, RESEND_API_KEY,
# VAPID_PRIVATE_KEY, GOOGLE_MAPS_API_KEY for the recommend function) are Edge
# Function secrets and NEVER belong in this file — see docs/HANDOFF.md §4.
#
# With none of these set, AuthGate bypasses and the Hebrew RTL shell still
# renders with no data. That is deliberate: it is how the smoke e2e suite runs.

# Supabase project — Settings → API.
# The anon key is safe in the browser; RLS is what protects the data.
# The service-role key must NEVER appear here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JS API — map screen and Places autocomplete.
# Restrict by HTTP referrer in the Google console; it is public once shipped.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth client id — Google Photos Picker only (not app login, which
# goes through Supabase Auth). Needs the photospicker.mediaitems.readonly scope.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web Push public VAPID key. Must be the pair of VAPID_PRIVATE_KEY held as an
# Edge Function secret — a mismatch fails at subscribe time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
