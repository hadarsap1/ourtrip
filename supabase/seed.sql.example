-- OurTrip seed — copy to seed.sql, fill in real values, run once with the
-- service role (Supabase SQL editor or `supabase db execute`).
-- Real owner emails live ONLY here / in env — never in committed code.

insert into trips (name, base_currency, is_active)
values ('הטיול הגדול', 'ILS', true);

insert into members (trip_id, email, display_name, role)
select t.id, v.email, v.display_name, 'owner'::member_role
from trips t,
     (values
       ('OWNER_EMAIL_1@example.com', 'הדר'),
       ('OWNER_EMAIL_2@example.com', 'סיון')
     ) as v(email, display_name)
where t.is_active;

-- Budget categories (Sprint 3 uses these)
insert into budget_categories (trip_id, key, label_he)
select t.id, v.key, v.label_he
from trips t,
     (values
       ('flights', 'טיסות'),
       ('lodging', 'לינה'),
       ('food', 'אוכל'),
       ('attractions', 'אטרקציות'),
       ('transport', 'תחבורה'),
       ('shopping', 'קניות'),
       ('prep', 'הכנות לטיול'),
       ('misc', 'בלת"מ')
     ) as v(key, label_he)
where t.is_active;

-- Full-day family dry-run checklist (Sprint 8) — a reusable template the
-- family runs once before departure to shake out the whole app end-to-end.
-- Instantiate it from the checklists screen (keeps source_template_id).
with tpl as (
  insert into checklists (trip_id, title, is_template)
  select t.id, 'יום ניסיון משפחתי לפני הטיול', true from trips t where t.is_active
  returning id
)
insert into checklist_items (checklist_id, label, sort_order)
select tpl.id, v.label, v.ord
from tpl,
     (values
       ('לארוז את תיק היום ולבדוק שכל המשפחה יודעת מה בפנים', 0),
       ('להעביר את הטלפון למצב טיסה ולוודא שמסלול היום נטען לא מקוון', 1),
       ('לפתוח מסמך מסומן לצפייה לא מקוונת (דרכון/ביטוח) בלי אינטרנט', 2),
       ('לפתוח את דף החירום של מדינת היום במצב לא מקוון', 3),
       ('לפתוח את השיחון ולעבור למצב "הצג למקומי"', 4),
       ('לרשום הוצאה לדוגמה במטבע זר ולראות המרה לשקלים', 5),
       ('לבדוק כניסת ילד/ה בטאבלט עם קוד PIN אחרי הפעלה מחדש', 6),
       ('הילדים מעלים תמונה — ההורים מאשרים ומשתפים לאורחים', 7),
       ('לשמור פין "איפה החניה" ולנווט אליו חזרה', 8),
       ('להפעיל התראות (Web Push) בטלפון של כל הורה', 9),
       ('אורח פותח את הפורטל ורואה רק תוכן משותף', 10),
       ('לשלוח הודעה בקיר המשפחתי ולוודא שהיא מגיעה לכולם', 11)
     ) as v(label, ord);

-- NOTE: members.auth_user_id stays null until each owner's first Google login;
-- the login callback links auth.users.id to the members row by email.
